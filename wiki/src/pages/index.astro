---
// 官网首页把首次使用路径放在首屏，把项目边界和 Wiki 入口放在后续阅读中。
import { ArrowRight, ArrowUpRight } from '@lucide/astro';
import Base from "../layouts/Base.astro";
---

<Base
    title="GoDoIt · 够独特"
    description="更优雅的 Godot 引擎启动器与版本管理器。"
>
    <section class="home-hero">
        <div class="hero-inner">
            <div class="hero-copy">
                <p class="eyebrow"><span>GoDoIt</span> / Godot launcher</p>
                <h1>
                    不等戈多，自己动手！<br /><em
                        >你的 Godot 启动可以更加优雅</em
                    >
                </h1>
                <p class="hero-lead">
                    GoDoIt 管理引擎、SDK
                    和启动环境。你选定一个条目，它负责把正确的组合启动起来。
                </p>
                <div class="hero-actions">
                    <a
                        class="button primary"
                        href="/wiki/tutorials/hello-godot/">开始安装</a
                    >
                    <a class="text-link" href="/wiki/"
                        >先看 Wiki <ArrowUpRight size={16} stroke-width={1.8} aria-hidden="true" /></a
                    >
                </div>
                <div class="platform-support" aria-label="支持的平台">
                    <span class="platform-label">支持平台</span>
                    <span>Linux</span>
                    <span>macOS</span>
                    <span class="windows-platform">Windows</span>
                </div>
                <div class="hero-command" aria-label="示例命令">
                    <div class="command-label">第一次启动</div>
                    <code
                        ><span class="prompt">$</span> gdit install work --version
                        4.5.2 --current<br /><span class="prompt">$</span> gdit run</code
                    >
                </div>
            </div>
            <div class="hero-art" aria-hidden="true">
                <img src="/mascot.png" alt="" />
            </div>
        </div>
    </section>

    <section class="home-section entry-section">
        <div class="section-intro">
            <p class="eyebrow">从这里开始</p>
            <h2>你现在要做什么</h2>
            <p>每个入口只处理一件事。先完成动作，遇到疑问再回到解释。</p>
        </div>
        <div class="entry-list">
            <a class="entry-row" href="/wiki/tutorials/hello-godot/">
                <span class="entry-number">01</span>
                <span class="entry-main"
                    ><strong>第一次安装</strong><small
                        >从可用版本到启动编辑器，完整走一遍</small
                    ></span
                >
                <span class="entry-arrow" aria-hidden="true"><ArrowUpRight size={17} stroke-width={1.8} /></span>
            </a>
            <a class="entry-row" href="/wiki/how-to/install-version/">
                <span class="entry-number">02</span>
                <span class="entry-main"
                    ><strong>安装另一个版本</strong><small
                        >让多个 Godot 引擎并存，互不覆盖</small
                    ></span
                >
                <span class="entry-arrow" aria-hidden="true"><ArrowUpRight size={17} stroke-width={1.8} /></span>
            </a>
            <a class="entry-row" href="/wiki/how-to/switch-default/">
                <span class="entry-number">03</span>
                <span class="entry-main"
                    ><strong>切换当前条目</strong><small
                        >更换默认版本，继续使用 <code>godot</code> 命令</small
                    ></span
                >
                <span class="entry-arrow" aria-hidden="true"><ArrowUpRight size={17} stroke-width={1.8} /></span>
            </a>
        </div>
    </section>

    <section class="home-section model-section">
        <div class="model-copy">
            <p class="eyebrow">一个清楚的模型</p>
            <h2>条目是选择，资产是共享的。</h2>
            <p>
                一个条目描述引擎版本、edition、SDK 策略和环境变量。引擎和 SDK
                作为资产只安装一份，可以被多个条目引用。
            </p>
            <a class="text-link" href="/wiki/explanation/instances/"
                >读懂 instances <ArrowUpRight size={16} stroke-width={1.8} aria-hidden="true" /></a
            >
        </div>
        <div class="model-diagram" aria-label="条目与资产的关系示意">
            <div class="diagram-column">
                <span class="diagram-label">条目</span>
                <div class="diagram-file">
                    <b>work.toml</b><small>4.5.2 · standard</small>
                </div>
                <div class="diagram-file">
                    <b>game.toml</b><small>4.5.2 · dotnet</small>
                </div>
            </div>
            <div class="diagram-connector" aria-hidden="true">
                <ArrowRight size={22} stroke-width={1.7} />
            </div>
            <div class="diagram-column asset-column">
                <span class="diagram-label">共享资产</span>
                <div class="diagram-file">
                    <b>engines/4.5.2</b><small>只下载一次</small>
                </div>
                <div class="diagram-file">
                    <b>sdks/8.0.410</b><small>按需托管</small>
                </div>
            </div>
        </div>
    </section>

    <section class="home-section boundary-section">
        <div>
            <p class="eyebrow">边界</p>
            <h2>启动时保持克制。</h2>
        </div>
        <ul>
            <li>
                <span>01</span><strong>只读当前条目</strong><p>
                    普通 <code>godot</code> 不看项目目录，也不会按目录自动切换。
                </p>
            </li>
            <li>
                <span>02</span><strong>只改子进程环境</strong><p>
                    显示驱动、输入法和 SDK 变量只传给这次启动的引擎。
                </p>
            </li>
            <li>
                <span>03</span><strong>所有下载显式发生</strong><p>
                    运行和切换不会联网，也不会悄悄安装或删除资产。
                </p>
            </li>
        </ul>
    </section>
    <style>
        .home-hero {
            overflow: hidden;
            border-bottom: 1px solid var(--line);
            background: var(--surface);
        }
        .hero-inner {
            width: min(100% - 2rem, 1240px);
            min-height: 590px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(360px, 0.85fr);
            align-items: center;
            gap: 2rem;
        }
        .hero-copy {
            position: relative;
            z-index: 1;
            padding: 5.5rem 0 5rem;
        }
        .eyebrow {
            margin: 0 0 1rem;
            color: var(--accent-secondary);
            font-family: "JetBrains Mono", ui-monospace, monospace;
            font-size: 0.73rem;
            font-weight: 750;
            letter-spacing: 0;
            text-transform: uppercase;
        }
        .eyebrow span {
            color: var(--cyan);
        }
        .hero-copy h1 {
            max-width: 720px;
            margin: 0;
            font-size: 5.6rem;
            font-weight: 800;
            letter-spacing: 0;
            line-height: 1.04;
            text-wrap: balance;
        }
        .hero-copy h1 em {
            color: var(--accent);
            font-style: normal;
        }
        .hero-lead {
            max-width: 570px;
            margin: 1.5rem 0 0;
            color: var(--ink-soft);
            font-size: 1.14rem;
            text-wrap: pretty;
        }
        .hero-actions {
            display: flex;
            align-items: center;
            gap: 1.35rem;
            margin-top: 2rem;
        }
        .button {
            display: inline-flex;
            min-height: 46px;
            align-items: center;
            justify-content: center;
            padding: 0.6rem 1.1rem;
            border: 1px solid var(--accent-strong);
            border-radius: var(--radius-sm);
            font-weight: 750;
            text-decoration: none;
        }
        .button.primary {
            background: var(--accent-strong);
            color: #fff;
        }
        .button.primary:hover {
            background: var(--accent);
            color: #fff;
        }
        .text-link {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            color: var(--accent-strong);
            font-weight: 700;
            text-decoration: none;
        }
        .text-link svg {
            transition: transform 0.15s;
        }
        .text-link:hover svg {
            transform: translate(0.15rem, -0.15rem);
        }
        .hero-command {
            width: min(100%, 530px);
            margin-top: 1.5rem;
            border-top: 1px solid var(--line-strong);
            padding-top: 0.85rem;
        }
        .platform-support {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 0.45rem 1rem;
            margin-top: 2.25rem;
            color: var(--ink-faint);
            font-family: "JetBrains Mono", ui-monospace, monospace;
            font-size: 0.72rem;
            font-weight: 650;
        }
        .platform-label {
            color: var(--accent-secondary);
        }
        .windows-platform {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
        }
        .windows-platform img {
            width: 15px;
            height: 15px;
        }
        .command-label {
            margin-bottom: 0.35rem;
            color: var(--ink-faint);
            font-size: 0.72rem;
            font-weight: 700;
        }
        .hero-command code {
            display: block;
            border: 0;
            background: none;
            color: var(--ink-soft);
            padding: 0;
            font-size: 0.82rem;
            line-height: 1.9;
        }
        .hero-command .prompt {
            color: var(--cyan);
            user-select: none;
        }
        .hero-art {
            position: relative;
            align-self: stretch;
            min-height: 590px;
            isolation: isolate;
        }
        .hero-art::before {
            content: "";
            position: absolute;
            inset: 12% -4% 0 20%;
            z-index: -2;
            background: var(--accent-soft);
            border-radius: var(--radius-md) var(--radius-md) 0 0;
        }
        .hero-art img {
            position: absolute;
            right: 5%;
            bottom: 0;
            z-index: -1;
            width: min(76%, 440px);
            height: 94%;
            object-fit: contain;
            object-position: bottom center;
        }
        .home-section {
            width: min(100% - 2rem, 1080px);
            margin: 0 auto;
            padding: 6rem 0;
        }
        .section-intro {
            max-width: 540px;
        }
        .entry-section {
            display: grid;
            grid-template-columns: minmax(220px, 0.72fr) minmax(0, 1.28fr);
            gap: clamp(2rem, 7vw, 7rem);
            align-items: start;
            border-top: 1px solid var(--line);
        }
        .home-section h2 {
            margin: 0;
            font-size: 2.6rem;
            line-height: 1.18;
            letter-spacing: 0;
            text-wrap: balance;
        }
        .section-intro > p:last-child,
        .model-copy > p:not(.eyebrow) {
            margin: 0.85rem 0 0;
            color: var(--ink-soft);
        }
        .entry-list {
            margin-top: 0;
            border-top: 1px solid var(--line);
        }
        .entry-row {
            display: grid;
            grid-template-columns: 52px minmax(0, 1fr) 32px;
            gap: 1rem;
            align-items: center;
            min-height: 86px;
            border-bottom: 1px solid var(--line);
            color: var(--ink);
            text-decoration: none;
        }
        .entry-row:hover {
            color: var(--ink);
            background: var(--surface-subtle);
        }
        .entry-number {
            color: var(--accent-secondary);
            font-family: "JetBrains Mono", ui-monospace, monospace;
            font-size: 0.73rem;
            font-weight: 750;
        }
        .entry-main {
            display: flex;
            flex-direction: column;
            gap: 0.18rem;
        }
        .entry-main strong {
            font-size: 1.04rem;
        }
        .entry-main small {
            color: var(--ink-soft);
            font-size: 0.86rem;
        }
        .entry-main code {
            font-size: 0.82em;
        }
        .entry-arrow {
            display: inline-flex;
            justify-content: flex-end;
            color: var(--accent);
        }
        .model-section {
            display: grid;
            grid-template-columns: 0.8fr 1.2fr;
            gap: clamp(2rem, 8vw, 8rem);
            align-items: center;
            border-top: 1px solid var(--line);
        }
        .model-copy .text-link {
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            margin-top: 1.45rem;
        }
        .model-diagram {
            display: grid;
            grid-template-columns: minmax(0, 1fr) 80px minmax(0, 1fr);
            align-items: center;
            gap: 0.65rem;
        }
        .diagram-column {
            display: flex;
            flex-direction: column;
            gap: 0.7rem;
        }
        .diagram-label {
            color: var(--ink-faint);
            font-family: "JetBrains Mono", ui-monospace, monospace;
            font-size: 0.7rem;
            font-weight: 700;
        }
        .diagram-file {
            padding: 0.75rem 0.85rem;
            background: var(--surface);
            border: 1px solid var(--line);
            border-radius: var(--radius-sm);
        }
        .diagram-file b,
        .diagram-file small {
            display: block;
        }
        .diagram-file b {
            color: var(--ink);
            font-family: "JetBrains Mono", ui-monospace, monospace;
            font-size: 0.78rem;
            font-weight: 650;
        }
        .diagram-file small {
            margin-top: 0.22rem;
            color: var(--ink-faint);
            font-size: 0.73rem;
        }
        .diagram-connector {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: var(--accent);
        }
        .boundary-section {
            display: grid;
            grid-template-columns: 0.8fr 1.2fr;
            gap: clamp(2rem, 8vw, 8rem);
            border-top: 1px solid var(--line);
        }
        .boundary-section ul {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 1.2rem;
            list-style: none;
            margin: 0;
            padding: 0;
        }
        .boundary-section li {
            padding-top: 0.8rem;
            border-top: 1px solid var(--line);
        }
        .boundary-section li > span {
            display: block;
            margin-bottom: 0.55rem;
            color: var(--accent-secondary);
            font-family: "JetBrains Mono", ui-monospace, monospace;
            font-size: 0.7rem;
            font-weight: 750;
        }
        .boundary-section li strong {
            font-size: 0.96rem;
        }
        .boundary-section li p {
            margin: 0;
            color: var(--ink-soft);
            font-size: 0.86rem;
        }
        @media (max-width: 800px) {
            .hero-inner {
                display: block;
                min-height: 0;
            }
            .hero-copy {
                padding: 4rem 0 2rem;
            }
            .hero-copy h1 {
                font-size: 3.45rem;
            }
            .home-section h2 {
                font-size: 2.15rem;
            }
            .hero-lead {
                font-size: 1rem;
            }
            .hero-command {
                margin-top: 1.4rem;
            }
            .platform-support {
                margin-top: 1.8rem;
            }
            .hero-art {
                min-height: 310px;
            }
            .hero-art img {
                right: 2%;
                width: min(58%, 270px);
                height: 100%;
            }
            .hero-art::before {
                inset: 9% 8% 0 26%;
            }
            .home-section {
                padding: 4rem 0;
            }
            .entry-section {
                display: block;
            }
            .entry-list {
                margin-top: 2.2rem;
            }
            .model-section,
            .boundary-section {
                display: block;
            }
            .model-diagram {
                margin-top: 2.2rem;
                grid-template-columns: 1fr 34px 1fr;
                gap: 0.35rem;
            }
            .diagram-file {
                padding: 0.65rem;
            }
            .diagram-file b {
                font-size: 0.68rem;
                word-break: break-word;
            }
            .diagram-file small {
                font-size: 0.66rem;
            }
            .boundary-section ul {
                margin-top: 2.2rem;
                grid-template-columns: 1fr;
                gap: 0;
            }
        }
        @media (prefers-reduced-motion: reduce) {
            .text-link svg {
                transition: none;
            }
        }
    </style>
</Base>
